# ─────────────────────────────────────────────────────────────
# BAX Autopilot configuration. Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────

# Model provider: "ollama" (local-first, default) or "anthropic" (cloud).
AUTOPILOT_PROVIDER=ollama

# Host Ollama endpoint. From inside the orchestrator container on macOS,
# the host is reachable at host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434

# Per-role model overrides (defaults tuned for a 96 GB M3 Ultra).
# Roles: coder | planner | router
AUTOPILOT_MODEL_CODER=qwen2.5-coder:32b
AUTOPILOT_MODEL_PLANNER=qwen2.5:32b-instruct
AUTOPILOT_MODEL_ROUTER=llama3.2:3b

# Cloud override models (used only when AUTOPILOT_PROVIDER=anthropic, or when a
# role is individually pointed at anthropic via AUTOPILOT_PROVIDER_<ROLE>).
ANTHROPIC_API_KEY=
AUTOPILOT_ANTHROPIC_MODEL_CODER=claude-sonnet-5
AUTOPILOT_ANTHROPIC_MODEL_PLANNER=claude-opus-4-8
AUTOPILOT_ANTHROPIC_MODEL_ROUTER=claude-haiku-4-5

# Autonomy budgets (hard safety caps — the loop aborts cleanly when exceeded).
AUTOPILOT_MAX_FIX_ITERS=6
AUTOPILOT_STEP_BUDGET=120
AUTOPILOT_TOKEN_BUDGET=0            # 0 = unlimited (local); set a cap for cloud
AUTOPILOT_MAX_PARALLEL_CODERS=3    # parallel coder workers (bounded by 1 GPU)
AUTOPILOT_FIX_INNER_RETRIES=2      # fast rebuild-only re-patches per fix step

# Deploy gate. "plan" (default) runs terraform validate+plan only.
# "apply" additionally runs terraform apply — requires GCP creds below.
AUTOPILOT_DEPLOY=plan

# GCP defaults for generated apps' Terraform.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Postgres (harness state + LangGraph checkpointer).
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=autopilot
DATABASE_URL=postgresql://autopilot:autopilot@postgres:5432/autopilot

# Git integration for the integrator agent.
GITHUB_TOKEN=
GIT_AUTHOR_NAME=bax-autopilot
GIT_AUTHOR_EMAIL=autopilot@bax.local
