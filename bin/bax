#!/usr/bin/env bash
# bax — pull the repo, bring the harness up, and kick off a run from an intent.
# Usage:  bin/bax "a full-stack todo app with email/password auth and a tasks API"
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

ORCH_URL="${ORCHESTRATOR_URL:-http://localhost:8080}"
INTENT="${*:-}"

if [[ -z "$INTENT" ]]; then
  echo "usage: bin/bax \"<intent>\"" >&2
  exit 1
fi

# 1. Sync the repo (best-effort; skip if not a checkout or offline).
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "▸ git pull…"
  git pull --ff-only || echo "  (skipped: $(git rev-parse --abbrev-ref HEAD) not fast-forwardable)"
fi

# 2. Ensure the harness is up.
if ! curl -fsS "$ORCH_URL/healthz" >/dev/null 2>&1; then
  echo "▸ starting harness (docker compose up)…"
  docker compose up -d --build
  echo -n "  waiting for orchestrator"
  for _ in $(seq 1 60); do
    curl -fsS "$ORCH_URL/healthz" >/dev/null 2>&1 && break
    echo -n "."; sleep 2
  done
  echo
fi

# 3. Submit the intent.
echo "▸ submitting intent: $INTENT"
RUN_ID="$(curl -fsS -X POST "$ORCH_URL/runs" \
  -H 'content-type: application/json' \
  -d "$(printf '{"intent": %s}' "$(printf '%s' "$INTENT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')")" \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["run_id"])')"

echo "▸ run started: $RUN_ID"
echo "  poll:   curl $ORCH_URL/runs/$RUN_ID"
echo "  logs:   docker compose logs -f orchestrator"

# 4. Stream status until terminal.
while true; do
  STATUS="$(curl -fsS "$ORCH_URL/runs/$RUN_ID" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("status","?"), d.get("phase",""))')"
  echo "  [$RUN_ID] $STATUS"
  case "$STATUS" in
    done*|blocked*|error*) break ;;
  esac
  sleep 5
done
