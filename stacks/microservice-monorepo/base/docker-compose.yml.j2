# {{ app_name }} — {{ summary }}
# Generated by BAX Autopilot. Run the whole system from the repo root:  make up
services:
{% for f in frontends %}
  {{ f.name }}:
    build: ./{{ f.name }}
    environment:
      PORT: "{{ f.port | default(3000) }}"
      NEXT_PUBLIC_API_URL: "http://localhost:{{ (node_services[0].port if node_services else 4000) }}"
    ports:
      - "{{ f.port | default(3000) }}:{{ f.port | default(3000) }}"
    depends_on:
{% for s in node_services %}
      - {{ s.name }}
{% endfor %}
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://localhost:{{ f.port | default(3000) }}/').then(r=>process.exit(0)).catch(()=>process.exit(1))\""]
      interval: 10s
      timeout: 5s
      retries: 12
{% endfor %}
{% for s in node_services %}
  {{ s.name }}:
    build: ./services/{{ s.name }}
    environment:
      PORT: "{{ s.port | default(4000) }}"
      DATABASE_URL: "postgresql://app:app@db:5432/app"
    ports:
      - "{{ s.port | default(4000) }}:{{ s.port | default(4000) }}"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "node -e \"fetch('http://localhost:{{ s.port | default(4000) }}/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""]
      interval: 10s
      timeout: 5s
      retries: 12
{% endfor %}
  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: app
    ports:
      - "5432:5432"
    volumes:
      - ./db/init:/docker-entrypoint-initdb.d:ro
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app"]
      interval: 5s
      timeout: 5s
      retries: 12

volumes:
  pgdata:
