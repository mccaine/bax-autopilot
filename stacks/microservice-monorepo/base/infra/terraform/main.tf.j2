# {{ app_name }} — GCP deployment (generated by BAX Autopilot).
# One Cloud Run service per app service; Cloud SQL for Postgres; Artifact Registry
# for images. Postgres is Cloud SQL (not Cloud Run) because Cloud Run is stateless.

locals {
  app = "{{ app_name }}"
  services = {
{% for s in node_services %}    "{{ s.name }}" = { port = {{ s.port | default(4000) }}, public = false }
{% endfor %}{% for f in frontends %}    "{{ f.name }}" = { port = {{ f.port | default(3000) }}, public = true }
{% endfor %}  }
}

# ── Artifact Registry (Docker images) ─────────────────────────────────
resource "google_artifact_registry_repository" "images" {
  location      = var.region
  repository_id = local.app
  format        = "DOCKER"
}

# ── Cloud SQL (PostgreSQL) ────────────────────────────────────────────
resource "google_sql_database_instance" "db" {
  name             = "${local.app}-db"
  database_version = "POSTGRES_16"
  region           = var.region
  settings {
    tier = "db-f1-micro"
  }
  deletion_protection = false
}

resource "google_sql_database" "app" {
  name     = "app"
  instance = google_sql_database_instance.db.name
}

resource "google_sql_user" "app" {
  name     = "app"
  instance = google_sql_database_instance.db.name
  password = var.db_password
}

# ── Cloud Run services ────────────────────────────────────────────────
resource "google_cloud_run_v2_service" "svc" {
  for_each = local.services

  name     = "${local.app}-${each.key}"
  location = var.region

  template {
    containers {
      image = "${var.region}-docker.pkg.dev/${var.project_id}/${local.app}/${each.key}:${var.image_tag}"
      ports {
        container_port = each.value.port
      }
      env {
        name  = "DATABASE_URL"
        value = "postgresql://app:${var.db_password}@/app?host=/cloudsql/${google_sql_database_instance.db.connection_name}"
      }
    }
    volumes {
      name = "cloudsql"
      cloud_sql_instance {
        instances = [google_sql_database_instance.db.connection_name]
      }
    }
  }
}

# Allow unauthenticated access to public (frontend) services only.
resource "google_cloud_run_v2_service_iam_member" "public" {
  for_each = { for k, v in local.services : k => v if v.public }

  name     = google_cloud_run_v2_service.svc[each.key].name
  location = var.region
  role     = "roles/run.invoker"
  member   = "allUsers"
}
